<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tripRequestRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/travel_surface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/page_header_height"
        android:background="@color/travel_navy"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="@dimen/screen_horizontal_padding">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_header_icon"
            android:contentDescription="@string/content_description_back"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tripRequestTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/new_trip_title"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tripRequestSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/new_trip_subtitle"
                android:textColor="#CAD1E0"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/tripRequestScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal_padding"
            android:paddingTop="14dp"
            android:paddingEnd="@dimen/screen_horizontal_padding"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_agent_tile">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_spark" />
                </FrameLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/travel_border"
                    app:strokeWidth="1dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="2dp"
                        android:padding="14dp"
                        android:text="@string/agent_trip_prompt"
                        android:textColor="@color/travel_text"
                        android:textSize="13sp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView
                style="@style/TravelHubFieldLabel"
                android:layout_marginTop="16dp"
                android:text="@string/destination" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/destinationInputLayout"
                style="@style/TravelHubFieldContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/destinationInput"
                    style="@style/TravelHubFieldInput"
                    android:inputType="textCapWords"
                    android:singleLine="true"
                    android:text="@string/destination_example" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/TravelHubFieldLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/start_date" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <TextView
                    style="@style/TravelHubFieldLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/end_date" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/startDateInputLayout"
                    style="@style/TravelHubFieldContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/startDateInput"
                        style="@style/TravelHubFieldInput"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:singleLine="true"
                        android:text="@string/start_date_example" />
                </com.google.android.material.textfield.TextInputLayout>

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/endDateInputLayout"
                    style="@style/TravelHubFieldContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/endDateInput"
                        style="@style/TravelHubFieldInput"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:singleLine="true"
                        android:text="@string/end_date_example" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                style="@style/TravelHubFieldLabel"
                android:layout_marginTop="14dp"
                android:text="@string/budget_sgd" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/budgetInputLayout"
                style="@style/TravelHubFieldContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:prefixText="@string/budget_prefix"
                app:prefixTextColor="@color/travel_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/budgetInput"
                    style="@style/TravelHubFieldInput"
                    android:digits="0123456789,."
                    android:inputType="numberDecimal"
                    android:singleLine="true"
                    android:text="@string/budget_example" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TravelHubFieldLabel"
                android:layout_marginTop="14dp"
                android:text="@string/preferences" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/preferencesGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="0dp"
                app:selectionRequired="false"
                app:singleLine="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/cityCentreChip"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:checkable="true"
                    android:checked="true"
                    android:text="@string/preference_city_centre"
                    android:textSize="12sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/preference_chip_background"
                    app:chipCornerRadius="18dp"
                    app:chipStrokeColor="@color/travel_border"
                    app:chipStrokeWidth="1dp"
                    app:ensureMinTouchTargetSize="false"
                    android:textColor="@color/preference_chip_text" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/directFlightsChip"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:checkable="true"
                    android:checked="true"
                    android:text="@string/preference_direct_flights"
                    android:textSize="12sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/preference_chip_background"
                    app:chipCornerRadius="18dp"
                    app:chipStrokeColor="@color/travel_border"
                    app:chipStrokeWidth="1dp"
                    app:ensureMinTouchTargetSize="false"
                    android:textColor="@color/preference_chip_text" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/familyFriendlyChip"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:checkable="true"
                    android:text="@string/preference_family_friendly"
                    android:textSize="12sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/preference_chip_background"
                    app:chipCornerRadius="18dp"
                    app:chipStrokeColor="@color/travel_border"
                    app:chipStrokeWidth="1dp"
                    app:ensureMinTouchTargetSize="false"
                    android:textColor="@color/preference_chip_text" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/businessHotelChip"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:checkable="true"
                    android:text="@string/preference_business_hotel"
                    android:textSize="12sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/preference_chip_background"
                    app:chipCornerRadius="18dp"
                    app:chipStrokeColor="@color/travel_border"
                    app:chipStrokeWidth="1dp"
                    app:ensureMinTouchTargetSize="false"
                    android:textColor="@color/preference_chip_text" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                style="@style/TravelHubFieldLabel"
                android:layout_marginTop="10dp"
                android:text="@string/anything_else" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/TravelHubFieldContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/notesInput"
                    style="@style/TravelHubFieldInput"
                    android:layout_height="74dp"
                    android:gravity="top|start"
                    android:hint="@string/notes_hint"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="3"
                    android:paddingTop="13dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sendToAgentButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/send_to_agent"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/travel_gold"
                    app:cornerRadius="8dp" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/requestProgress"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="34dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/white"
                    app:indicatorSize="22dp"
                    app:trackThickness="2dp" />
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/tripRequestBottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_navigation_height"
        android:background="@color/white"
        android:elevation="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        app:itemIconSize="22dp"
        app:itemIconTint="@color/bottom_navigation_tint"
        app:itemRippleColor="@color/travel_gold_soft"
        app:itemTextColor="@color/bottom_navigation_tint"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_navigation" />

</LinearLayout>
