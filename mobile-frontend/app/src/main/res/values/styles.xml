<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TravelHubFieldContainer">
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxBackgroundMode">outline</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxStrokeColor">@color/travel_border</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="hintEnabled">false</item>
    </style>

    <style name="TravelHubFieldInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/travel_text</item>
        <item name="android:textColorHint">@color/travel_text_muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TravelHubFieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/travel_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
